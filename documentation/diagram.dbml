
Table Test {
  id integer [primary key]
  name varchar
  year integer
  educationalEntityId integer
}

Table Area {
  id integer [primary key]
  name varchar
}

Table Subject {
  id integer [primary key]
  name varchar
  areaId integer
}

Table SubSubject {
  id integer [primary key]
  name varchar
  subjectId integer
}

Table Question {
  id integer [primary key]
  questionText varchar
  difficulty Difficulty
  image byte
  subSubjectId integer
}

Table Alternative {
  id integer [primary key]
  text varchar
  isCorrect boolean
  questionId integer
  image byte  
}

Table TestQuestion {
  testId integer
  questionId integer
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
} 

Ref: Subject.areaId > Area.id
Ref: SubSubject.subjectId > Subject.id

Ref: Question.subSubjectId > SubSubject.id

Ref: Alternative.questionId > Question.id

Ref: TestQuestion.testId > Test.id
Ref: TestQuestion.questionId > Question.id